@Named("loginBean")
@SessionScoped
public class LoginBean extends CetarsLoginBean {
	private static final String APP_KEY = "${appKey}"; //This may need to be changed to the value the old code used for module/APP_KEY

	// With the introduction of the new login util, we are not changing the faces
	// key, but may have to in the future if issues arise
//	private String errorMessage = null;
//	private ArrayList<User> logins = new ArrayList<User>();
//	private boolean multipleLogins = false;
//	private UIData userIds = new UIData();
//	private static final String LOGIN_SUCCESSFUL = "loginSuccessful";
	public static final String FACES_KEY = "loginBean";
	private static final String LOGIN_VALID = "loginSuccessful";
	//private static String dodId = Optional.ofNullable(FacesContext.getCurrentInstance().getExternalContext().getUserPrincipal().getName()).orElse("1073325737");
	//private String dodId = "";
	
	
	private LoginBean() {
		
		String dodTemp = Optional.ofNullable(FacesContext.getCurrentInstance())
	
		        .map(FacesContext::getExternalContext)
		        .map(ExternalContext::getUserPrincipal)
		        .map(Principal::getName)
		        .orElse("1073325737"); // Default used if Filter is off or context is missing
		setDodId(dodTemp);
	  System.out.println("In getDodId in Login Bean: dodId was set to:" + dodTemp  );
	}

public void localCacLogin() {
	cacLogin(APP_KEY);  //This may need to be changed to the value the old code used for module
	if(!isInvalidLogin()) {
		redirectToStartPage();
	}
}
private void  redirectToStartPage() {
	FacesContext facesContext = FacesContext.getCurrentInstance();
	HttpServletRequest req = (HttpServletRequest) facesContext.getExternalContext().getRequest();
	String startUrl = URLConstructionUtility.constructContextURL(req) + "/faces/content/common/start.xhtml";

	//logger.debug("Redirecting to start page: " + startUrl);

	Object object = facesContext.getExternalContext().getResponse();

	if (object instanceof HttpServletResponse) {
		HttpServletResponse response = (HttpServletResponse) object;
		try {
			String x = response.encodeURL(startUrl);
			System.out.println(x);
			response.sendRedirect(x);

		} catch (IOException e) {
			System.out.println("Test");
			e.printStackTrace();
		}
	}
}
